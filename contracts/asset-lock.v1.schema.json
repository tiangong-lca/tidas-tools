{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong.earth/contracts/tidas/asset-lock.v1.schema.json",
  "title": "TIDAS executable asset lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_roots", "entries"],
  "properties": {
    "schema_version": {
      "const": "tidas.asset-lock.v1"
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "json-schema",
              "chinese-json-schema",
              "methodology",
              "runtime-ruleset",
              "validation-index",
              "xsd",
              "xslt",
              "xml-reference",
              "legacy-schema-lock"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
