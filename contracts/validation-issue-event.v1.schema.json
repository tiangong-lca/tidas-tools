{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong.earth/contracts/tidas/validation-issue-event.v1.schema.json",
  "title": "TIDAS validation issue event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "issue_ordinal", "issue"],
  "properties": {
    "type": {
      "const": "issue"
    },
    "schema_version": {
      "const": "tidas.validation-issue-event.v1"
    },
    "issue_ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "issue": {
      "$ref": "#/$defs/issue"
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_code",
        "severity",
        "category",
        "file_path",
        "location",
        "message",
        "context"
      ],
      "properties": {
        "issue_code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object"
        }
      }
    }
  }
}
