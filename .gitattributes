# Executable assets and machine contracts are hashed byte-for-byte. Keep their
# checked-out bytes identical on Linux, macOS, and Windows.
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.xsd text eol=lf
*.xsl text eol=lf

# This upstream ILCD schema is intentionally locked with CRLF bytes. Treat it
# as an opaque executable asset so checkout never rewrites the locked payload.
src/tidas_tools/eilcd/schemas/ILCD_LifeCycleModelDataSet.xsd -text

# Source, manifests, scripts, and governed documentation also use the repo's LF
# determinism contract.
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
Cargo.lock text eol=lf
